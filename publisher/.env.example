# Publisher Environment Variables
# Copy to .env and modify as needed

# Config path (relative to project root)
CONFIG_PATH=../config.yaml

# Log level
LOG_LEVEL=info

# Optional: absolute path to ffmpeg.exe (use this if spawn ffmpeg ENOENT)
